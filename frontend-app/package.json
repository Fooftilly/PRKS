{
  "name": "prks-frontend-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PRKS Vue 3 application source. Node/npm are maintainer build tools only. The Python runtime serves the committed bundle in frontend/vue/.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "openapi:types": "node scripts/generate-openapi-types.mjs",
    "openapi:check": "node scripts/generate-openapi-types.mjs --check",
    "build": "node scripts/build.mjs",
    "build:workspace-model": "node scripts/build-workspace-model.mjs",
    "build:work-route": "node scripts/build-work-route.mjs",
    "build:search-codec": "node scripts/build-search-codec.mjs",
    "build:tab-leave": "node scripts/build-tab-leave.mjs",
    "build:owner-resource": "node scripts/build-owner-resource.mjs",
    "build:route-model": "node scripts/build-route-model.mjs",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --output-dir storybook-static --disable-telemetry"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@floating-ui/dom": "1.8.0",
    "@tanstack/vue-query": "5.104.0",
    "@vueuse/core": "13.9.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop-unit-testing": "2.1.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/vue3-vite": "10.6.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "storybook": "10.6.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vitest": "5.0.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
