{
  "name": "prks-frontend-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PRKS Vue 3 application source. Node/npm are maintainer build tools only. The Python runtime serves the committed bundle in frontend/vue/.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "build:workspace-model": "node scripts/build-workspace-model.mjs",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --output-dir storybook-static --disable-telemetry"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@tanstack/vue-query": "5.104.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop-unit-testing": "2.1.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "storybook": "10.6.0",
    "typescript": "5.9.2",
    "vite": "8.3.1",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  }
}
