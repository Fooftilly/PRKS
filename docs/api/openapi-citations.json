{
  "openapi": "3.1.0",
  "info": {
    "title": "PRKS API \u2014 Citations slice",
    "version": "0.1.0",
    "description": "Vertical-slice OpenAPI for citation export (#41). Schemas are generated from the same Pydantic boundary as the rest of backend/api_contract."
  },
  "paths": {
    "/api/citations": {
      "post": {
        "operationId": "exportCitations",
        "summary": "Read the selected Works' citations as CSL-JSON or BibTeX",
        "description": "Changes nothing. Each Work is cited from its citation Manifestation. Ids this Library has no Work for are listed in `missing` and left out.",
        "tags": [
          "citations"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CitationsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The found Works' citations, in request order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitationsResult"
                }
              }
            }
          },
          "400": {
            "description": "Domain refusal: not an object, unknown format, or an empty, malformed or too large selection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Request body larger than the JSON body limit (request_too_large).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Missing or unsupported Content-Type (unsupported_media_type).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorEnvelope": {
        "additionalProperties": false,
        "description": "Standard JSON error body at the HTTP adapter boundary.",
        "properties": {
          "error": {
            "description": "Human-readable error message.",
            "minLength": 1,
            "title": "Error",
            "type": "string"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Stable machine-readable code when the domain provides one.",
            "title": "Code"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Human-readable explanation sent with admission and route refusals.",
            "title": "Message"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "CitationsRequest": {
        "description": "POST /api/citations. At most ``PRKS_BULK_WORK_MAX`` ids, deduplicated in order by the domain.",
        "properties": {
          "work_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Work Ids",
            "type": "array"
          },
          "format": {
            "enum": [
              "csl-json",
              "bibtex"
            ],
            "title": "Format",
            "type": "string"
          }
        },
        "required": [
          "work_ids",
          "format"
        ],
        "type": "object"
      },
      "CslDate": {
        "additionalProperties": false,
        "properties": {
          "date-parts": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "title": "Date-Parts",
            "type": "array"
          }
        },
        "required": [
          "date-parts"
        ],
        "title": "CslDate",
        "type": "object"
      },
      "CslItem": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "author": {
            "items": {
              "$ref": "#/components/schemas/CslName"
            },
            "title": "Author",
            "type": "array"
          },
          "editor": {
            "items": {
              "$ref": "#/components/schemas/CslName"
            },
            "title": "Editor",
            "type": "array"
          },
          "translator": {
            "items": {
              "$ref": "#/components/schemas/CslName"
            },
            "title": "Translator",
            "type": "array"
          },
          "issued": {
            "$ref": "#/components/schemas/CslDate"
          },
          "accessed": {
            "$ref": "#/components/schemas/CslDate"
          },
          "genre": {
            "title": "Genre",
            "type": "string"
          },
          "container-title": {
            "title": "Container-Title",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "publisher-place": {
            "title": "Publisher-Place",
            "type": "string"
          },
          "edition": {
            "title": "Edition",
            "type": "string"
          },
          "volume": {
            "title": "Volume",
            "type": "string"
          },
          "issue": {
            "title": "Issue",
            "type": "string"
          },
          "page": {
            "title": "Page",
            "type": "string"
          },
          "ISBN": {
            "title": "Isbn",
            "type": "string"
          },
          "DOI": {
            "title": "Doi",
            "type": "string"
          },
          "URL": {
            "title": "Url",
            "type": "string"
          },
          "abstract": {
            "title": "Abstract",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "title": "CslItem",
        "type": "object"
      },
      "CslName": {
        "additionalProperties": false,
        "description": "A CSL name: ``family`` with an optional ``given``, or one ``literal`` (a channel).",
        "properties": {
          "family": {
            "title": "Family",
            "type": "string"
          },
          "given": {
            "title": "Given",
            "type": "string"
          },
          "literal": {
            "title": "Literal",
            "type": "string"
          }
        },
        "title": "CslName",
        "type": "object"
      },
      "CitationsCslJson": {
        "additionalProperties": false,
        "description": "``format: csl-json``: one item per found Work, in request order.",
        "properties": {
          "format": {
            "const": "csl-json",
            "title": "Format",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CslItem"
            },
            "title": "Items",
            "type": "array"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "title": "Missing",
            "type": "array"
          }
        },
        "required": [
          "format",
          "items",
          "missing"
        ],
        "type": "object"
      },
      "CitationsBibtex": {
        "additionalProperties": false,
        "description": "``format: bibtex``: each found Work's entry, separated by a blank line.",
        "properties": {
          "format": {
            "const": "bibtex",
            "title": "Format",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "title": "Missing",
            "type": "array"
          }
        },
        "required": [
          "format",
          "text",
          "missing"
        ],
        "type": "object"
      },
      "CitationsResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CitationsCslJson"
          },
          {
            "$ref": "#/components/schemas/CitationsBibtex"
          }
        ],
        "discriminator": {
          "propertyName": "format",
          "mapping": {
            "csl-json": "#/components/schemas/CitationsCslJson",
            "bibtex": "#/components/schemas/CitationsBibtex"
          }
        }
      }
    }
  }
}
