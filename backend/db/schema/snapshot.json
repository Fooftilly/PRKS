{
  "extensions": {
    "pg_trgm": "ext",
    "unaccent": "ext"
  },
  "format": 1,
  "functions": {
    "prks.identity_key(text)": {
      "definition": "CREATE OR REPLACE FUNCTION prks.identity_key(s text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nBEGIN ATOMIC\n SELECT casefold((btrim(regexp_replace(NORMALIZE(s, NFC), '[\\x09-\\x0D\\x1C-\\x20\\x85\\xA0\\x1680\\x2000-\\x200A\\x2028\\x2029\\x202F\\x205F\\x3000]+'::text, ' '::text, 'g'::text), ' '::text) COLLATE pg_unicode_fast)) AS casefold;\nEND\n",
      "parallel": "s",
      "strict": true,
      "volatility": "i"
    },
    "prks.search_norm(text)": {
      "definition": "CREATE OR REPLACE FUNCTION prks.search_norm(s text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nBEGIN ATOMIC\n SELECT ext.unaccent('prks.search_unaccent'::regdictionary, casefold((NORMALIZE(s, NFC) COLLATE pg_unicode_fast))) AS unaccent;\nEND\n",
      "parallel": "s",
      "strict": true,
      "volatility": "i"
    }
  },
