# Variables for docker-compose.yml (README.md "Docker"). Copy to .env and adjust;
# Compose reads .env from the project directory. Never put a password or a
# database URL in this file: both live in the secret files named below.

# Host user and group the PRKS containers run as, so files in the data
# directory belong to you (`id -u`, `id -g`).
UID=1000
GID=1000

# Host directory mounted at /data: the PRKS data root (its marker and the
# Library's PDFs and portraits). Create it yourself before the first `up`.
PRKS_DATA_DIR=./data

# Secret files (owner-only, chmod 600, never committed; secrets/ is ignored):
# the database password, and the full database URL built from it,
#   postgresql://prks:<password>@db:5432/prks
PRKS_DB_PASSWORD_FILE=./secrets/db_password
PRKS_DB_URL_FILE=./secrets/database_url

# Where the web port is published on the host. Loopback by default; publish
# on other interfaces only behind an HTTPS reverse proxy you control.
PRKS_PUBLISH_HOST=127.0.0.1
PRKS_PUBLISH_PORT=8080

# Behind an HTTPS reverse proxy: the origin browsers use, and the proxy
# addresses whose X-Forwarded-For is trusted (comma-separated).
PRKS_PUBLIC_ORIGIN=
PRKS_TRUSTED_PROXIES=
# Extra Host header values the web process accepts (comma-separated).
PRKS_TRUSTED_HOSTS=
