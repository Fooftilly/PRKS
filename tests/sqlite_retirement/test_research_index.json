      "replaced_by": [
        "tests/pg/test_research_index.py::ConcurrencyTests.test_a_work_deleted_while_a_reindex_of_it_is_paused_leaves_no_rows",
        "tests/pg/test_research_index.py::ConcurrencyTests.test_a_stale_reindex_after_the_delete_cannot_recreate_rows",
        "tests/pg/test_research_graph.py::StaleRowTests.test_a_deleted_work_leaves_the_reads_before_its_reindex_runs"
      ]
    },
    "ResearchIndexTests.test_corrupt_derived_recreated_canonical_untouched": {
      "replaced_by": [
        "tests/pg/test_admin_rebuild_derived.py::RebuildDerivedTests.test_queues_a_full_rebuild_once"
      ],
      "note": "The PostgreSQL index is the derived schema of the Library database, not a separate file that can be corrupt; it is rebuilt by the rebuild-derived job, which leaves canonical rows alone."
    },
