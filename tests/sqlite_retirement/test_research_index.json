        "tests/pg/test_research_index.py::JobTests.test_running_the_job_again_or_twice_changes_nothing"
      ],
      "note": "PostgreSQL reindexes by a job each note change enqueues, so an unchanged note enqueues nothing instead of being skipped by a reconcile pass."
    },
    "ResearchIndexTests.test_escaped_concept_delimiter_indexes_one_full_name": {
      "replaced_by": [
        "tests/pg/test_research_index.py::EncodedReferenceTests.test_an_escaped_concept_delimiter_indexes_one_full_name"
