#!/usr/bin/env bash
# The local PostgreSQL 18 server of `python prks_app.py --testing` (PG-C2 #641).
#
# `--testing` uses PRKS_DATABASE_URL when it is set, and otherwise
# postgresql://prks:prks@127.0.0.1:55433/prks_testing
# (TESTING_DEFAULT_DATABASE_URL in backend/db/config.py), which this helper
# serves from a Docker container with a named volume. The database is a
# testing instance only: this helper marks it for testing (COMMENT ON DATABASE
# ... IS 'prks-testing', which --testing requires before it writes anything),
# the first `--testing` start bootstraps its owner and Library and pairs it
# with data_testing/, and a non-testing process refuses it.
#
# Never use it for a real Library, and never point it at data/.
#
# Usage:
#   scripts/dev-postgres          # start (or reuse) the server and print the URL
#   scripts/dev-postgres stop     # stop the container, keep its data
#   scripts/dev-postgres reset    # delete the container and its data volume
#
# After `reset`, also delete data_testing/: the root is paired with the
# database that was deleted, so PRKS refuses to start on it.
set -euo pipefail

PG_IMAGE="postgres:18.6@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336"
CONTAINER="prks-dev-postgres"
VOLUME="prks-dev-pgdata"
PORT=55433
URL="postgresql://prks:prks@127.0.0.1:${PORT}/prks_testing"

if ! command -v docker >/dev/null 2>&1; then
  echo "dev-postgres: Docker is required (or set PRKS_DATABASE_URL to a PostgreSQL 18 database you created)." >&2
  exit 2
fi

case "${1:-start}" in
  start)
    if [[ -z "$(docker ps -aq --filter "name=^${CONTAINER}$")" ]]; then
      docker run -d --name "$CONTAINER" \
        -p "127.0.0.1:${PORT}:5432" \
        -e POSTGRES_USER=prks \
        -e POSTGRES_PASSWORD=prks \
        -e POSTGRES_DB=prks_testing \
        -e POSTGRES_INITDB_ARGS="--locale-provider=builtin --builtin-locale=PG_UNICODE_FAST" \
        -v "${VOLUME}:/var/lib/postgresql" \
        "$PG_IMAGE" >/dev/null
    else
      docker start "$CONTAINER" >/dev/null
    fi
    for _ in $(seq 1 60); do
      if docker exec "$CONTAINER" pg_isready -h 127.0.0.1 -U prks -d prks_testing >/dev/null 2>&1; then
        # The testing mark --testing requires (backend/db/testing_guard.py).
        # This container exists only for --testing, so its database is
        # always marked; nothing else ever sets this comment.
        docker exec "$CONTAINER" psql --no-psqlrc -q -v ON_ERROR_STOP=1 -U prks -d prks_testing \
          -c "COMMENT ON DATABASE prks_testing IS 'prks-testing'" >/dev/null
        echo "$URL"
        exit 0
      fi
      sleep 0.5
    done
    echo "dev-postgres: the server did not become ready; see: docker logs $CONTAINER" >&2
    exit 1
    ;;
  stop)
    docker stop "$CONTAINER" >/dev/null 2>&1 || true
    ;;
  reset)
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    docker volume rm "$VOLUME" >/dev/null 2>&1 || true
    echo "dev-postgres: deleted. Delete data_testing/ too before the next --testing start."
    ;;
  *)
    echo "usage: scripts/dev-postgres [start|stop|reset]" >&2
    exit 2
    ;;
esac
